# karpathy-claude-wiki —— scripts/ingest_helper.py 可选 API key 配置
#
# 什么时候需要这个文件？
# ------------------------------------------------------------------
# 不需要。只要你的 AI agent（Claude Code / Cursor / Cline / ...）能直接
# 读你喂的原始资料，ingest 协议就能正常跑。
#
# 什么时候会用上？
#   - 你要 ingest 大 PDF / 长播客文稿 / 几百页文档
#   - 直接把全文塞进主对话会烧很多 context
#   - 想让一个"便宜的外接 LLM"先把文档压成结构化 JSON，主 agent 再接力
#
# 配置方式
# ------------------------------------------------------------------
# 1. 把这个文件复制一份为 `.env`（跟这个文件放同一目录）
# 2. 在下面五家 provider 里选 **一家** 取消注释 + 填 key
# 3. `ingest_helper.py` 会自动探测哪家配了 key 就用哪家
#
# 注意：`.env` 已经在 `.gitignore` 里，不会被提交到 git。


# ─── Kimi / 月之暗面（国内，长文本友好）──────────────────────────────
# 注册：https://platform.moonshot.cn/
# 新用户通常有免费额度（金额随官方政策变动，请以官网为准）
# KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KIMI_MODEL=moonshot-v1-32k            # 或 moonshot-v1-128k（超长文档）
# KIMI_BASE_URL=https://api.moonshot.cn/v1


# ─── 智谱 GLM（国内，glm-4-flash 截至 2026-01 免费）──────────────────
# 注册：https://bigmodel.cn/
# GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GLM_MODEL=glm-4-flash                 # 免费档；追求质量换 glm-4-plus
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4


# ─── DeepSeek（国内，新用户送免费 credits）────────────────────────────
# 注册：https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


# ─── 阿里通义 Qwen / DashScope（国内大厂方案）─────────────────────────
# 注册：https://dashscope.console.aliyun.com/
# OpenAI 兼容模式文档：参考 help.aliyun.com DashScope 对应页面
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# QWEN_MODEL=qwen-plus                  # 或 qwen-turbo（更便宜）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ─── OpenAI（官方或任何 OpenAI 兼容端点）──────────────────────────────
# 注册：https://platform.openai.com/
# 如果你有自建反代 / 中转，只需改 OPENAI_BASE_URL
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
